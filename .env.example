# Copy this file to ".env" (same folder as manage.py) and fill it in.
# NEVER commit your real .env -- it is listed in .gitignore.

# --- Django (optional for local dev, required in production) ---
# DJANGO_SECRET_KEY=put-a-long-random-string-here
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Email (optional: without it, emails are printed in the terminal) ---
# Gmail example -- use an "App Password", NOT your normal Gmail password:
#   Google Account > Security > turn on 2-Step Verification > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your16letterapppassword

# --- AI habit coach (chatbot) ---
# Get a key from Google AI Studio: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=your-google-ai-studio-key-here
# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
# Valid names: https://ai.google.dev/gemini-api/docs/models  (e.g. gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
